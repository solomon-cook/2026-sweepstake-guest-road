# PostgreSQL connection string used by the Next.js server runtime.
# Prefer PRISMA_DATABASE_URL or POSTGRES_URL for the app runtime so it does not
# accidentally use a migration-only DATABASE_URL.
PRISMA_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/sweepstake"
OPENAI_API_KEY=""

# Optional aliases supported by src/lib/database-url.ts.
# POSTGRES_URL=""
# DATABASE_URL=""
