# PostgreSQL connection string used by the Next.js server runtime.
# Prefer a pooled app/runtime URL here. PRISMA_DATABASE_URL is reserved for
# Prisma CLI migration/seed workflows when it differs from the app URL.
POSTGRES_URL="postgresql://postgres:postgres@127.0.0.1:5432/sweepstake"
# PRISMA_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/sweepstake"
OPENAI_API_KEY=""

# Optional aliases supported by src/lib/database-url.ts.
# DATABASE_URL=""
