# PostgreSQL connection string used by Prisma and the Next.js server runtime.
# For Vercel Postgres/Marketplace databases, set POSTGRES_URL in Vercel.
# For local development, DATABASE_URL is usually enough.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/sweepstake"

# Optional aliases supported by src/lib/database-url.ts.
# POSTGRES_URL=""
# PRISMA_DATABASE_URL=""
