generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id                 String   @id @default(cuid())
  name               String   @unique
  flag               String   @default("")
  flagCode           String   @default("")
  flagImageBytes     Bytes?
  flagImageMimeType  String   @default("image/jpeg")
  group              String
  odds               Int
  impliedProbability Float
  score              Float
  rank               Int      @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  slotAssignments    DrawSlotTeam[]
}

model Draw {
  id         String     @id @default(cuid())
  playerCount Int       @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  slots      DrawSlot[]
}

model DrawSlot {
  id             String        @id @default(cuid())
  drawId         String
  slotIndex      Int
  playerName     String
  photoMimeType  String?
  photoData      Bytes?
  generatedImageMimeType String?
  neutralImageData Bytes?
  ecstaticImageData Bytes?
  devastatedImageData Bytes?
  fanImageStatus String @default("idle")
  fanImageError String?
  fanImageTeamId String?
  fanImageGeneratedAt DateTime?
  totalScore     Float
  isRevealed     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  draw           Draw          @relation(fields: [drawId], references: [id], onDelete: Cascade)
  teamAssignments DrawSlotTeam[]

  @@unique([drawId, slotIndex])
}

model ApiCache {
  key       String   @id
  payload   Json
  fetchedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DrawSlotTeam {
  id        String   @id @default(cuid())
  slotId    String
  teamId    String
  teamOrder Int
  slot      DrawSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([slotId, teamId])
  @@unique([slotId, teamOrder])
}
