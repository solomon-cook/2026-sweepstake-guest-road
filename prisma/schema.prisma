generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id                 String   @id @default(cuid())
  name               String   @unique
  group              String
  odds               Int
  impliedProbability Float
  score              Float
  rank               Int      @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
